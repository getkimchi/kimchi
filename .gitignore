# Dependencies
node_modules/

# Build output
dist/

# Copied pi-coding-agent assets (generated by scripts/copy-resources.js)
src/modes/interactive/theme/
src/core/export-html/

# IDE
.idea/
.vscode/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
AGENTS.local.md

# Test coverage
coverage/

# TUI E2E generated artifacts
.tui-test/
tui-traces/
**/tui-traces/
*.tui-e2e.txt
*.tui-e2e.log

# Kimchi docs and superpowers
# (contents ignored; tag defaults are shared team config — keep them versioned)
.kimchi/*
!.kimchi/tags.json
docs/superpowers
.benchmark/
.benchmark-summary/
.worktrees

# Exported session viewers (generated by /export)
kimchi-session-*.html

# Session logs/transcripts
*.jsonl
# Parser-test fixtures are source, not transcripts — keep them
!benchmark/manual/fixtures/*.jsonl

# Root-level test stubs only — src/__mocks__ is for vitest alias stubs and must be committed
/__mocks__/

*.bun-build

.memory
bin

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Memory spike workspace: the dataset is a documented external
# prerequisite and the build output is disposable (see its README)
benchmark/memory-spike/data/
benchmark/memory-spike/dist/

# Stray macOS-style bun cache from invocations with HOME at the repo root
Library/

# LLM tools
.codegraph/

# vendor/superpowers is a local-only directory, not a submodule
vendor/superpowers/

# Terraform local state and plans
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
