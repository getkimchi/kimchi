# Patch: OAuth Accept headers for spec-strict gateways (@modelcontextprotocol/client 2.3.1)
#
# Tracking:
#   - Spec-strict MCP gateways (e.g. agentgateway v1.5.0) answer 406 when the
#     Accept header lacks text/event-stream; upstream issue pending at
#     https://github.com/modelcontextprotocol/typescript-sdk (remove when
#     upstream sends "Accept: application/json, text/event-stream" on metadata
#     discovery and dynamic client registration)
#   - This is the v2 client package pi-mcp-adapter actually uses for MCP OAuth
#     at runtime; the parallel patch against the legacy
#     @modelcontextprotocol/sdk 1.29.0 covers entry points that still import
#     the 1.x package. Rebased from 2.0.0 to 2.3.1 alongside the
#     pi-mcp-adapter 5.3.0 bump; upstream still sends json-only Accept at all
#     three sites.
#   - Transient metadata errors during OAuth discovery: discoverOAuthServerInfo
#     treats any protected-resource-metadata failure other than a TypeError as
#     "no metadata" and falls back to the MCP origin as authorization server,
#     so a one-off 5xx/429 makes a re-auth discover the wrong issuer and fail
#     stored-issuer checks; upstream issue pending at
#     https://github.com/modelcontextprotocol/typescript-sdk (remove when
#     upstream only falls back when metadata is absent)
# Changes:
#   - dist/index.{mjs,cjs} tryMetadataDiscovery: add Accept
#     "application/json, text/event-stream" (covers RFC 9728 protected-resource
#     metadata).
#   - dist/index.{mjs,cjs} discoverAuthorizationServerMetadata: widen Accept
#     from "application/json" (RFC 8414/OIDC authorization-server metadata).
#   - dist/index.{mjs,cjs} registerClient (DCR POST): add Accept
#     "application/json, text/event-stream" (previously no Accept header).
#     The token POST (executeTokenRequest) is deliberately unchanged — it is a
#     plain form POST that worked against the affected gateway.
#   - Trap for rebasers: patch both the mjs and cjs mirrors; line numbers
#     differ between them.
#   - dist/index.{mjs,cjs} discoverOAuthServerInfo: rethrow protected-resource
#     metadata errors reporting HTTP 5xx or 429 instead of falling back to the
#     MCP origin; 404 and other failures keep the fallback. See the transient
#     metadata errors tracking entry above.
diff --git a/dist/index.cjs b/dist/index.cjs
index 71cf63076b073284aa14f63cd41efa653e8def0f..44b2eb056fb3a319ac95a6b6085dd38d5ace84c1 100644
--- a/dist/index.cjs
+++ b/dist/index.cjs
@@ -1017,7 +1017,7 @@ function buildWellKnownPath(wellKnownPrefix, pathname = "", options = {}) {
 * Tries to discover OAuth metadata at a specific URL
 */
 async function tryMetadataDiscovery(url, protocolVersion, fetchFn = fetch) {
-	return await fetchWithCorsRetry(url, { "MCP-Protocol-Version": protocolVersion }, fetchFn);
+	return await fetchWithCorsRetry(url, { "MCP-Protocol-Version": protocolVersion, Accept: "application/json, text/event-stream" }, fetchFn);
 }
 /**
 * Determines if fallback to root discovery should be attempted
@@ -1135,7 +1135,7 @@ function buildDiscoveryUrls(authorizationServerUrl) {
 async function discoverAuthorizationServerMetadata(authorizationServerUrl, { fetchFn = fetch, protocolVersion = _modelcontextprotocol_core_internal.LATEST_PROTOCOL_VERSION, skipIssuerValidation = false } = {}) {
 	const headers = {
 		"MCP-Protocol-Version": protocolVersion,
-		Accept: "application/json"
+		Accept: "application/json, text/event-stream"
 	};
 	const urlsToTry = buildDiscoveryUrls(authorizationServerUrl);
 	for (const { url: endpointUrl, type } of urlsToTry) {
@@ -1187,6 +1187,9 @@ async function discoverOAuthServerInfo(serverUrl, opts) {
 		if (resourceMetadata.authorization_servers && resourceMetadata.authorization_servers.length > 0) authorizationServerUrl = resourceMetadata.authorization_servers[0];
 	} catch (error) {
 		if (error instanceof TypeError) throw error;
+		// A transient server error (5xx/429) is not "no metadata": falling back to the
+		// MCP origin would discover the wrong authorization server.
+		if (error instanceof Error && /^HTTP (?:5\d\d|429)\b/.test(error.message)) throw error;
 	}
 	if (!authorizationServerUrl) authorizationServerUrl = String(new URL("/", serverUrl));
 	const authorizationServerMetadata = await discoverAuthorizationServerMetadata(authorizationServerUrl, {
@@ -1440,7 +1443,7 @@ async function registerClient(authorizationServerUrl, { metadata, clientMetadata
 	};
 	const response = await require_src.fetchWithinOrigin(fetchFn ?? fetch)(registrationUrl, {
 		method: "POST",
-		headers: { "Content-Type": "application/json" },
+		headers: { "Content-Type": "application/json", Accept: "application/json, text/event-stream" },
 		body: JSON.stringify(submittedMetadata)
 	});
 	if (!response.ok) throw new RegistrationRejectedError({
