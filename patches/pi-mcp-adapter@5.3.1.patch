+import type { ExtensionContext } from "@earendil-works/pi-coding-agent";
+import type { McpExtensionState } from "./state.ts";
+import type { McpConfig, McpReloadContext, ProjectServerBlock, ReloadConfigOptions, ServerEntry, SessionReloadOutcome } from "./types.ts";
+/** The ExtensionContext surface reloadConfig needs. */
+type ReloadContext = McpReloadContext;
+type ReloadAction = "add" | "remove" | "disable" | "blocked" | "transport" | "exposure";
+/** Result of one server's reconcile: ok, or needs-auth (reconnect skipped or landed unauthenticated). */
+type DispatchResult = "ok" | "needs-auth";
+interface ReloadPlanEntry {
+    name: string;
+    action: ReloadAction;
+    definition?: ServerEntry;
+    blockedReason?: string;
+}
+/**
+ * Runtime config reload for one live adapter state: re-read, re-resolve
+ * trust, diff, and reconcile. Per-server failures are isolated (error bucket);
+ * the tool surface re-syncs through the state's metadata-updated hook, and the
+ * status snapshot is republished so both surfaces' UIs refresh.
+ */
+export declare function reloadConfig(state: McpExtensionState, ctx: ReloadContext, opts?: ReloadConfigOptions): Promise<SessionReloadOutcome>;
