+/**
+ * Remote-capable `/mcp-auth` fallback for modes without TUI overlays (rpc, ACP).
+ *
+ * `canRenderPanel()` gates the AltScreen picker on `ctx.mode === "tui"`, so
+ * protocol hosts used to hit a dead end on bare `/mcp-auth`. Those hosts do
+ * implement the dialog primitives (`ui.select`, `ui.input`), so ask for the
+ * server with a plain select and run the same per-server authenticateServer
+ * flow that `/mcp-auth <server>` uses — including the post-auth reconnect.
+ */
+async function openMcpAuthFallback(
+  state: McpExtensionState,
+  ctx: ExtensionContext,
+): Promise<PanelFlowResult> {
+  if (state.programmaticConfig) {
+    ctx.ui.notify("Use /mcp-auth <server> to authenticate a server from the in-memory SDK config.", "info");
+    return { configChanged: false };
+  }
+
+  const config = state.config;
+  const oauthServers = Object.entries(config.mcpServers).filter(
+    ([, definition]) => !isServerDisabled(definition) && supportsOAuth(definition),
+  );
+  if (oauthServers.length === 0) {
+    ctx.ui.notify("No OAuth-capable MCP servers are configured.", "warning");
+    return { configChanged: false };
+  }
+
+  const names = oauthServers.map(([name]) => name);
+  let serverName: string | undefined = names[0];
+  if (names.length > 1) {
+    serverName = await ctx.ui.select("Select an OAuth MCP server to authenticate", names);
+  }
+  if (!serverName) return { configChanged: false };
+
+  const result = await authenticateServer(serverName, config, ctx, state.owner?.signal, state.oauthRuntime);
+  if (result.ok) {
+    await reconnectServer(state, ctx, serverName);
+  }
+  return { configChanged: false };
+}
