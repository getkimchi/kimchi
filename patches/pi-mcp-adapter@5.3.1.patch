@@ -0,0 +1,354 @@
+// reload.ts - Runtime config reload: re-read → diff → reconcile
+//
+// Driven by the host through McpReloadHandle (see McpAdapterOptions
+// .reloadHandleSink): re-reads the config from the same sources the session's
+// state was built from, re-resolves project-server trust, diffs against the
+// live state per computeServerHash, and reconciles each server:
+//
+// - added (incl. disabled:true→false) → register into config only; the lazy
+//   connect gates materialize the connection on first touch.
+// - removed → eager teardown (unregister → close → config delete → deferred
+//   catalog eviction → residue cleanup).
+// - disabled:false→true → surface teardown; config entry and metadata cache
+//   are kept so re-enabling reuses them.
+// - changed (transport/auth fields) → eager manager.reconnect + fresh
+//   tools/list + metadata refresh, guarded against racing an in-flight
+//   interactive OAuth flow (hasPendingAuth).
+// - changed (exposure-only fields) → config entry swap + tool-surface
+//   re-sync; a healthy connection survives.
+//
+// A reload never races the tool surface's freeze contract: with
+// settings.freezeDirectTools in force, any tool-set-changing diff is refused
+// before any mutation. Host-merged per-session overlay servers
+// (state.overlayServerNames) are excluded from the diff on both sides — they
+// are additive and survive base-config removal.
+import { isServerDisabled } from "./types.js";
+import { cloneMcpConfig, loadMcpConfig, resolveConfiguredClaudePluginMcp } from "./config.js";
+import { computeServerHash, evictServerMetadataCache } from "./metadata-cache.js";
+import { hasPendingAuth } from "./mcp-auth-flow.js";
+import { applyProjectServerTrustToConfig, describeProjectServerBlock } from "./project-server-trust.js";
+import { clearFailure, markKeepAliveAfterConnect, notifyToolMetadataUpdated, recordFailure, updateMetadataCache, updateServerMetadata, updateStatusBar } from "./init.js";
+import { logger } from "./logger.js";
+/** Exposure/visibility-only fields: changing them re-syncs the tool surface without touching the connection. */
+const EXPOSURE_FIELDS = ["directTools", "includeTools", "excludeTools", "toolPrefix", "description"];
+function exposurePick(definition) {
+    const pick = {};
+    for (const field of EXPOSURE_FIELDS)
+        pick[field] = definition[field];
+    return pick;
+}
+function exposureChanged(oldDefinition, newDefinition) {
+    return JSON.stringify(exposurePick(oldDefinition)) !== JSON.stringify(exposurePick(newDefinition));
+}
+/**
+ * Hash of the transport/auth-identity fields only: exposure fields (and the
+ * trust layer's `disabled` flag, classified separately) are stripped before
+ * computeServerHash, so a pure exposure change never classifies as transport.
+ */
+function transportHash(definition) {
+    const stripped = { ...definition };
+    for (const field of EXPOSURE_FIELDS)
+        delete stripped[field];
+    delete stripped.disabled;
+    return computeServerHash(stripped);
+}
+/**
+ * Mirrors init's per-server lifecycle registration so (re-)added servers get
+ * idle cleanup and keep-alive health recovery like configured servers.
+ */
+function registerServerLifecycle(state, name, definition) {
+    const lifecycleMode = definition.lifecycle ?? "lazy";
+    const persistsAfterFirstSpawn = lifecycleMode === "eager" || lifecycleMode === "lazy-keep-alive";
+    const idleOverride = definition.idleTimeout ?? (persistsAfterFirstSpawn ? 0 : undefined);
+    state.lifecycle.registerServer(name, definition, idleOverride !== undefined ? { idleTimeout: idleOverride } : undefined);
+    if (lifecycleMode === "keep-alive")
+        state.lifecycle.markKeepAlive(name, definition);
+}
+/**
+ * Post-reconnect metadata refresh — the reconnectServer sequence: rebuild
+ * metadata from the fresh tools/list, persist the cache entry, clear failure
+ * backoff, notify (which re-syncs the tool surface), and restore keep-alive.
+ */
+function refreshConnectedMetadata(state, name) {
+    updateServerMetadata(state, name);
+    updateMetadataCache(state, name);
+    const restored = clearFailure(state, name, "config-reload");
+    if (!restored)
+        notifyToolMetadataUpdated(state, name, "config-reload");
+    markKeepAliveAfterConnect(state, name);
