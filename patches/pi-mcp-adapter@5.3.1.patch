+// reload.ts - Runtime config reload: re-read → diff → reconcile
+//
+// Driven by the host through McpReloadHandle (see McpAdapterOptions
+// .reloadHandleSink): re-reads the config from the same sources the session's
+// state was built from, re-resolves project-server trust, diffs against the
+// live state per computeServerHash, and reconciles each server:
+//
+// - added (incl. disabled:true→false) → register into config only; the lazy
+//   connect gates materialize the connection on first touch.
+// - removed → eager teardown (unregister → close → config delete → deferred
+//   catalog eviction → residue cleanup).
+// - disabled:false→true → surface teardown; config entry and metadata cache
+//   are kept so re-enabling reuses them.
+// - changed (transport/auth fields) → eager manager.reconnect + fresh
+//   tools/list + metadata refresh, guarded against racing an in-flight
+//   interactive OAuth flow (hasPendingAuth).
+// - changed (exposure-only fields) → config entry swap + tool-surface
+//   re-sync; a healthy connection survives.
+//
+// A reload never races the tool surface's freeze contract: with
+// settings.freezeDirectTools in force, any tool-set-changing diff is refused
+// before any mutation. Host-merged per-session overlay servers
+// (state.overlayServerNames) are excluded from the diff on both sides — they
+// are additive and survive base-config removal.
+import type { McpExtensionState } from "./state.ts";
+import {
+  isServerDisabled,
+  type McpConfig,
+  type McpReloadContext,
+  type ProjectServerBlock,
+  type ReloadConfigOptions,
+  type ReloadServerError,
+  type ServerEntry,
+  type SessionReloadOutcome,
+} from "./types.ts";
+import { cloneMcpConfig, loadMcpConfig, resolveConfiguredClaudePluginMcp } from "./config.ts";
+import { computeServerHash, evictServerMetadataCache } from "./metadata-cache.ts";
+import { hasPendingAuth } from "./mcp-auth-flow.ts";
+import { applyProjectServerTrustToConfig, describeProjectServerBlock } from "./project-server-trust.ts";
+import {
+  clearFailure,
+  markKeepAliveAfterConnect,
+  notifyToolMetadataUpdated,
+  recordFailure,
+  updateMetadataCache,
+  updateServerMetadata,
+  updateStatusBar,
+} from "./init.ts";
+import { logger } from "./logger.ts";
+
+/** Exposure/visibility-only fields: changing them re-syncs the tool surface without touching the connection. */
+const EXPOSURE_FIELDS = ["directTools", "includeTools", "excludeTools", "toolPrefix", "description"] as const;
+
+/** The ExtensionContext surface reloadConfig needs. */
+type ReloadContext = McpReloadContext;
+
+type ReloadAction = "add" | "remove" | "disable" | "blocked" | "transport" | "exposure";
+
+/** Result of one server's reconcile: ok, or needs-auth (reconnect skipped or landed unauthenticated). */
+type DispatchResult = "ok" | "needs-auth";
+
+interface ReloadPlanEntry {
+  name: string;
+  action: ReloadAction;
+  definition?: ServerEntry;
+  blockedReason?: string;
+}
+
+function exposurePick(definition: ServerEntry): Record<string, unknown> {
+  const pick: Record<string, unknown> = {};
+  for (const field of EXPOSURE_FIELDS) pick[field] = definition[field];
+  return pick;
+}
+
+function exposureChanged(oldDefinition: ServerEntry, newDefinition: ServerEntry): boolean {
+  return JSON.stringify(exposurePick(oldDefinition)) !== JSON.stringify(exposurePick(newDefinition));
+}
+
+/**
+ * Hash of the transport/auth-identity fields only: exposure fields (and the
+ * trust layer's `disabled` flag, classified separately) are stripped before
+ * computeServerHash, so a pure exposure change never classifies as transport.
+ */
+function transportHash(definition: ServerEntry): string {
+  const stripped: ServerEntry = { ...definition };
+  for (const field of EXPOSURE_FIELDS) delete stripped[field];
+  delete (stripped as Partial<Record<"disabled", unknown>>).disabled;
+  return computeServerHash(stripped);
+}
+
+/**
+ * Mirrors init's per-server lifecycle registration so (re-)added servers get
+ * idle cleanup and keep-alive health recovery like configured servers.
+ */
+function registerServerLifecycle(state: McpExtensionState, name: string, definition: ServerEntry): void {
+  const lifecycleMode = definition.lifecycle ?? "lazy";
+  const persistsAfterFirstSpawn = lifecycleMode === "eager" || lifecycleMode === "lazy-keep-alive";
+  const idleOverride = definition.idleTimeout ?? (persistsAfterFirstSpawn ? 0 : undefined);
+  state.lifecycle.registerServer(name, definition, idleOverride !== undefined ? { idleTimeout: idleOverride } : undefined);
+  if (lifecycleMode === "keep-alive") state.lifecycle.markKeepAlive(name, definition);
+}
+
+/**
+ * Post-reconnect metadata refresh — the reconnectServer sequence: rebuild
+ * metadata from the fresh tools/list, persist the cache entry, clear failure
+ * backoff, notify (which re-syncs the tool surface), and restore keep-alive.
+ */
+function refreshConnectedMetadata(state: McpExtensionState, name: string): void {
+  updateServerMetadata(state, name);
+  updateMetadataCache(state, name);
+  const restored = clearFailure(state, name, "config-reload");
+  if (!restored) notifyToolMetadataUpdated(state, name, "config-reload");
+  markKeepAliveAfterConnect(state, name);
+}
+
+/** Per-session runtime residue for one server (the config entry itself is managed by the dispatch). */
+function clearLiveServerState(state: McpExtensionState, name: string, keepSessionMetadata = false): void {
+  if (!keepSessionMetadata) state.sessionMetadata?.delete(name);
+  state.toolMetadata.delete(name);
+  state.resourceCounts?.delete(name);
+  state.directToolCounts?.delete(name);
+  state.promptMetadata?.delete(name);
+  state.promptMetadataLive?.delete(name);
+  state.serverInstructions.delete(name);
+  state.failureTracker.delete(name);
+  state.failureMessages?.delete(name);
+  state.blockedProjectServers?.delete(name);
+}
+
+function emptyBuckets(): Pick<SessionReloadOutcome, "added" | "removed" | "changed" | "unchanged" | "blocked" | "needsAuth" | "serverErrors"> {
+  return { added: [], removed: [], changed: [], unchanged: [], blocked: [], needsAuth: [], serverErrors: [] };
+}
+
+function reloadErrorOutcome(message: string): SessionReloadOutcome {
+  return { status: "error", error: message, ...emptyBuckets() };
+}
+
+/**
+ * Re-read the config from the sources this session's state was built from and
+ * re-resolve project-server trust, mirroring initializeMcp's branch:
+ * file-backed sessions re-run `loadMcpConfig` on the captured path/cwd and
+ * `applyProjectServerTrustToConfig`; programmatic sessions re-apply the
+ * host-supplied config (the host re-runs its own load + selection).
+ */
+async function readFreshConfig(
+  state: McpExtensionState,
+  ctx: ReloadContext,
+): Promise<{ config: McpConfig; blockedServers: Map<string, ProjectServerBlock> }> {
+  if (state.programmaticConfig) {
+    if (!state.reloadProgrammaticConfigProvider) {
+      throw new Error("MCP reload: programmatic config has no re-application provider");
+    }
+    const reapplied = await state.reloadProgrammaticConfigProvider(ctx);
+    if (!reapplied) throw new Error("MCP reload: programmatic config provider returned no config");
+    return {
+      config: resolveConfiguredClaudePluginMcp(cloneMcpConfig(reapplied), state.reloadCwd ?? ctx.cwd),
+      blockedServers: new Map(),
+    };
+  }
+  return applyProjectServerTrustToConfig(loadMcpConfig(state.reloadConfigPath, state.reloadCwd ?? ctx.cwd), ctx);
+}
+
+/** Classifies the per-server diff between the live config and the freshly loaded one. */
+function planReload(
+  state: McpExtensionState,
+  fresh: McpConfig,
+  blockedServers: ReadonlyMap<string, ProjectServerBlock>,
+  opts: ReloadConfigOptions,
+): { plan: ReloadPlanEntry[]; unchanged: string[] } {
+  const oldServers = state.config.mcpServers;
+  const newServers = fresh.mcpServers;
+  const overlayNames = state.overlayServerNames;
+  const isOverlay = (name: string): boolean => overlayNames?.has(name) ?? false;
+  const scope = opts.servers !== undefined ? new Set(opts.servers) : undefined;
+  const inScope = (name: string): boolean => scope === undefined || scope.has(name);
+
+  const plan: ReloadPlanEntry[] = [];
+  const unchanged: string[] = [];
+  for (const name of new Set([...Object.keys(oldServers), ...Object.keys(newServers)])) {
+    if (!inScope(name)) continue;
+    const oldDefinition = oldServers[name];
+    const newDefinition = newServers[name];
+    if (isOverlay(name)) {
+      // Per-session overlays are additive (D3): they survive base removal and
+      // are never removed, changed, or disconnected by a reload.
+      if (oldDefinition !== undefined || newDefinition !== undefined) unchanged.push(name);
+      continue;
+    }
+    if (state.runtimeServerNames?.has(name)) {
+      // Runtime-registered servers (pi.registerMcpServer / the built-in gateway)
+      // live only in state: config files and the programmatic provider never
+      // mention them. Leave them to the register/dispose lifecycle — never
+      // classify them as removed (their runtimeServers entry outlives the
+      // reload, and re-registration would throw 'already registered').
+      if (oldDefinition !== undefined || newDefinition !== undefined) unchanged.push(name);
+      continue;
+    }
+    const block = blockedServers.get(name);
+    if (block) {
+      plan.push({ name, action: "blocked", definition: newDefinition, blockedReason: describeProjectServerBlock(block.reason) });
+      continue;
+    }
+    if (newDefinition === undefined) {
+      plan.push({ name, action: "remove" });
+      continue;
+    }
+    if (oldDefinition === undefined || (isServerDisabled(oldDefinition) && !isServerDisabled(newDefinition))) {
+      plan.push({ name, action: "add", definition: newDefinition });
+      continue;
+    }
+    if (!isServerDisabled(oldDefinition) && isServerDisabled(newDefinition)) {
+      plan.push({ name, action: "disable", definition: newDefinition });
+      continue;
+    }
+    if (isServerDisabled(oldDefinition) && isServerDisabled(newDefinition)) {
+      // Disabled on both sides: no runtime footprint to reconcile.
+      unchanged.push(name);
+      continue;
+    }
+    if (transportHash(oldDefinition) !== transportHash(newDefinition)) {
+      plan.push({ name, action: "transport", definition: newDefinition });
+      continue;
+    }
+    if (exposureChanged(oldDefinition, newDefinition)) {
+      plan.push({ name, action: "exposure", definition: newDefinition });
+      continue;
+    }
+    unchanged.push(name);
+  }
+  return { plan, unchanged };
+}
+
+/** True when the diff would churn the model-facing tool surface (the freeze contract's trigger). */
+function isToolSetChanging(plan: readonly ReloadPlanEntry[]): boolean {
+  return plan.some(entry =>
+    entry.action === "add" ||
+    entry.action === "remove" ||
+    entry.action === "disable" ||
+    entry.action === "exposure" ||
+    entry.action === "blocked");
+}
+
+/** Reconciles one planned server. Returns "needs-auth" when the reconnect was skipped or landed unauthenticated. */
+async function dispatchPlanEntry(state: McpExtensionState, entry: ReloadPlanEntry): Promise<DispatchResult> {
+  switch (entry.action) {
+    case "add": {
+      // Register into config only: no connection work — the #1574 lazy gates
+      // materialize the connection (and its catalog) on first touch.
+      state.config.mcpServers[entry.name] = entry.definition!;
+      registerServerLifecycle(state, entry.name, entry.definition!);
+      notifyToolMetadataUpdated(state, entry.name, "config-reload-added");
+      return "ok";
+    }
+    case "remove": {
+      // Eager teardown, in order: lifecycle → connection → config → deferred
+      // catalog → residue. A tool already mid-call on this server errors with
+      // a clear tool error.
+      state.lifecycle.unregisterServer(entry.name);
+      await state.manager.close(entry.name);
+      delete state.config.mcpServers[entry.name];
+      evictServerMetadataCache(entry.name);
+      clearLiveServerState(state, entry.name);
+      notifyToolMetadataUpdated(state, entry.name, "config-reload-removed");
+      return "ok";
+    }
+    case "disable": {
+      // Surface teardown like removal, but keep the config entry and both
+      // metadata caches so re-enabling reuses them.
+      state.config.mcpServers[entry.name] = entry.definition!;
+      state.lifecycle.unregisterServer(entry.name);
+      await state.manager.close(entry.name);
+      clearLiveServerState(state, entry.name, true);
+      notifyToolMetadataUpdated(state, entry.name, "config-reload-disabled");
+      return "ok";
+    }
+    case "blocked": {
+      // Blocked by project-server trust: never connected. A live connection
+      // from before the block tears down; the (disabled) entry stays so the
+      // status surface can explain the block.
+      const wasConnected = state.manager.getConnection(entry.name) !== undefined;
+      if (entry.definition !== undefined) state.config.mcpServers[entry.name] = entry.definition;
+      if (wasConnected) {
+        state.lifecycle.unregisterServer(entry.name);
+        await state.manager.close(entry.name);
+      }
+      clearLiveServerState(state, entry.name, true);
+      // Mirror disablement: a server that was live before the block must have
+      // its direct tools and prompt metadata re-synced in this same pass.
+      notifyToolMetadataUpdated(state, entry.name, "config-reload-blocked");
+      return "ok";
+    }
+    case "transport": {
+      // EAGER reconnect (changed definition must not serve from the stale
+      // connection — manager.connect would return it unchanged). A server
+      // with no live connection has nothing stale: the new definition
+      // materializes lazily on first touch.
+      state.config.mcpServers[entry.name] = entry.definition!;
+      const current = state.manager.getConnection(entry.name);
+      if (current === undefined) return "ok";
+      if (hasPendingAuth(entry.name, state.authStorageOptions, state.oauthRuntime ?? undefined)) {
+        // An interactive OAuth flow owns this server right now; reconnecting
+        // under it would create competing OAuth owners. The #1574 call-path
+        // gates heal the definition swap on the next touch instead.
+        return "needs-auth";
+      }
+      const connection = await state.manager.reconnect(entry.name, entry.definition!, current, state.owner.signal);
+      if (connection.status === "needs-auth") return "needs-auth";
+      refreshConnectedMetadata(state, entry.name);
+      return "ok";
+    }
+    case "exposure": {
+      // No reconnect: a healthy connection survives; the model-visible
+      // registry refreshes in place via the metadata-updated hook.
+      state.config.mcpServers[entry.name] = entry.definition!;
+      notifyToolMetadataUpdated(state, entry.name, "config-reload-exposure");
+      return "ok";
+    }
+  }
+}
+
+/**
+ * Runtime config reload for one live adapter state: re-read, re-resolve
+ * trust, diff, and reconcile. Per-server failures are isolated (error bucket);
+ * the tool surface re-syncs through the state's metadata-updated hook, and the
+ * status snapshot is republished so both surfaces' UIs refresh.
+ */
+export async function reloadConfig(
+  state: McpExtensionState,
+  ctx: ReloadContext,
+  opts: ReloadConfigOptions = {},
+): Promise<SessionReloadOutcome> {
+  state.owner.throwIfInactive();
+
+  let fresh: McpConfig;
+  let blockedServers: ReadonlyMap<string, ProjectServerBlock>;
+  try {
+    const loaded = await readFreshConfig(state, ctx);
+    fresh = loaded.config;
+    blockedServers = loaded.blockedServers;
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    logger.debug(`MCP: config reload failed to re-read config: ${message}`);
+    return reloadErrorOutcome(message);
+  }
+  // Trust re-resolution replaces the block set wholesale; fail-closed comes
+  // from the trust resolver itself, and no new grant is minted mid-apply.
+  state.blockedProjectServers = new Map(blockedServers);
+
+  const { plan, unchanged } = planReload(state, fresh, blockedServers, opts);
+  const outcome: SessionReloadOutcome = {
+    status: "applied",
+    ...emptyBuckets(),
+    unchanged: [...unchanged],
+  };
+
+  // Freeze gate (settings.freezeDirectTools): refuse tool-set-changing diffs
+  // before any mutation — a bypass would knowingly serve an incoherent
+  // registry, which is exactly what the freeze exists to prevent. Pure
+  // transport changes still apply: the registry doesn't churn.
+  if (state.directToolsFrozen === true && isToolSetChanging(plan)) {
+    outcome.status = "refused";
+    outcome.reason = "direct_tools_frozen";
+    return outcome;
+  }
+
+  for (const entry of plan) {
+    try {
+      const dispatched = await dispatchPlanEntry(state, entry);
+      if (dispatched === "needs-auth") {
+        outcome.needsAuth.push(entry.name);
+        continue;
+      }
+      switch (entry.action) {
+        case "add":
+          outcome.added.push(entry.name);
+          break;
+        case "remove":
+          outcome.removed.push(entry.name);
+          break;
+        case "disable":
+        case "transport":
+        case "exposure":
+          outcome.changed.push(entry.name);
+          break;
+        case "blocked":
+          outcome.blocked.push({
+            name: entry.name,
+            blockedReason: entry.blockedReason ?? "project server requires trust",
+          });
+          break;
+      }
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      outcome.serverErrors.push({ name: entry.name, message } satisfies ReloadServerError);
+      recordFailure(state, entry.name, message);
+      logger.debug(`MCP: config reload failed for ${entry.name}: ${message}`);
+    }
+  }
+
+  if (outcome.serverErrors.length > 0) outcome.status = "error";
+  // Republish so the TUI status bar / /mcp panel and the ACP status snapshot
+  // reflect the reconciled state without any new affordance.
+  updateStatusBar(state);
+  return outcome;
+}
