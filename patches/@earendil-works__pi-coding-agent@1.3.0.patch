     async reloadFromStorageAsync(options) {
+        // File-backed reads skip the exclusive lock (needed only for
+        // modify()'s read-modify-write): a crashed process's orphaned lock
+        // otherwise stalls startup reads for 30s. Must return the bare
+        // credential map — the shape withLockAsync produces after
+        // destructuring { result, next }.
+        if (this.authPath) {
+            // A lock-free read can observe a partial file mid-write (upstream
+            // modify() is truncate-then-write; kimchi's syncPiAuth is atomic).
+            // Tears are transient — retry with backoff.
+            const RETRIES = 3;
+            const BACKOFF_MS = 10;
+            for (let attempt = 0; ; attempt++) {
+                options?.signal?.throwIfAborted();
+                try {
+                    const content = existsSync(this.authPath) ? readFileSync(this.authPath, "utf-8") : undefined;
+                    // parseStorageData() maps empty content to {} WITHOUT
+                    // throwing, so a read sampling a non-atomic writer's
+                    // open(O_TRUNC) window would resolve "no credentials" and
+                    // skip the retry — the request then hard-fails its auth
+                    // fallback. Treat the 0-byte read as a tear; a missing
+                    // file (content === undefined) stays a valid
+                    // no-credentials state.
+                    if (content === "")
+                        throw new Error("auth.json read empty (torn non-atomic write)");
+                    const currentData = this.parseStorageData(content);
+                    this.updateReadState(currentData, getFileRevision(this.authPath));
+                    return currentData;
+                }
+                catch (error) {
+                    if (attempt >= RETRIES)
+                        throw error;
+                    await new Promise((resolve) => setTimeout(resolve, BACKOFF_MS));
+                }
+            }
+        }
+        // In-memory storage: no file, no lock contention — use the backend.
         return this.storage.withLockAsync(async (content) => {
             const currentData = this.parseStorageData(content);
             const revision = this.authPath ? getFileRevision(this.authPath) : undefined;
