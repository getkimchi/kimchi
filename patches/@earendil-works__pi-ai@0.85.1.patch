# Patch: Kimchi compatibility fixes for pi-ai 0.84.1
#
# Tracking: LLM-2564. No matching upstream issue exists yet; report these
# changes to https://github.com/earendil-works/pi before the next upgrade.
# Changes: accept JSON-encoded array/object tool arguments (including {} as
# an empty array) and count LiteLLM cache_creation_tokens as cache writes.
# Removal: delete each hunk when the pinned Pi release provides that behavior.
#
diff --git a/dist/api/openai-completions.js b/dist/api/openai-completions.js
index 12416ccfa65c34e2c713302fe0dd5c01b1086900..ce56a36d59de3ad588f0e90f798b4abae5f329a4 100644
--- a/dist/api/openai-completions.js
+++ b/dist/api/openai-completions.js
@@ -1106,7 +1106,7 @@ function convertTools(tools, compat) {
 function parseChunkUsage(rawUsage, model) {
     const promptTokens = rawUsage.prompt_tokens || 0;
     const cacheReadTokens = rawUsage.prompt_tokens_details?.cached_tokens ?? rawUsage.prompt_cache_hit_tokens ?? 0;
-    const cacheWriteTokens = rawUsage.prompt_tokens_details?.cache_write_tokens || 0;
+    const cacheWriteTokens = rawUsage.prompt_tokens_details?.cache_write_tokens ?? rawUsage.prompt_tokens_details?.cache_creation_tokens ?? 0;
     // Follow documented OpenAI/OpenRouter semantics: cached_tokens is cache-read
     // tokens (hits). OpenAI does not document or emit cache_write_tokens, but
     // OpenRouter-compatible providers can include it as a separate write count.
