# Patch: OAuth Accept headers for spec-strict gateways (@modelcontextprotocol/sdk 1.29.0)
#
# Tracking: internal kimchi MCP OAuth investigation (2026-10) — spec-strict
# gateways (agentgateway v1.5.0, e.g. mcp.cicd.castai.co) answer 406 to OAuth
# requests whose Accept header omits text/event-stream. Upstream issue to be
# filed at modelcontextprotocol/typescript-sdk.
# Removal: when upstream's discoverAuthorizationServerMetadata and registerClient
# send "Accept: application/json, text/event-stream".
# Changes:
#   - dist/{esm,cjs}/client/auth.js: metadata discovery GET sends Accept
#     "application/json, text/event-stream" (was "application/json").
#   - dist/{esm,cjs}/client/auth.js: DCR registerClient POST adds Accept
#     "application/json, text/event-stream" (was no Accept header).
#   The token POST (executeTokenRequest) is deliberately left unchanged.
#   The token POST (executeTokenRequest) is deliberately unchanged.
# RESIDUAL RISK: a spec-strict server may now legitimately answer the DCR
#   POST with Content-Type text/event-stream, which the SDK's JSON-only
#   registerClient response parsing would reject. The target gateway
#   (Keycloak behind agentgateway) returns JSON for DCR; rebasers should
#   re-verify that still holds on SDK upgrades.
diff --git a/dist/cjs/client/auth.js b/dist/cjs/client/auth.js
index c2e4fa91d26f5336889f6afa416147db75fc4872..95770630378ca7ed2586e6590745231bc4a02161 100644
--- a/dist/cjs/client/auth.js
+++ b/dist/cjs/client/auth.js
@@ -632,7 +632,7 @@ function buildDiscoveryUrls(authorizationServerUrl) {
 async function discoverAuthorizationServerMetadata(authorizationServerUrl, { fetchFn = fetch, protocolVersion = types_js_1.LATEST_PROTOCOL_VERSION } = {}) {
     const headers = {
         'MCP-Protocol-Version': protocolVersion,
-        Accept: 'application/json'
+        Accept: 'application/json, text/event-stream'
     };
     // Get the list of URLs to try
     const urlsToTry = buildDiscoveryUrls(authorizationServerUrl);
@@ -928,7 +928,8 @@ async function registerClient(authorizationServerUrl, { metadata, clientMetadata
     const response = await (fetchFn ?? fetch)(registrationUrl, {
         method: 'POST',
         headers: {
-            'Content-Type': 'application/json'
+            'Content-Type': 'application/json',
+            Accept: 'application/json, text/event-stream'
         },
         body: JSON.stringify({
             ...clientMetadata,
