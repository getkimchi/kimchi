@@ -903,7 +903,8 @@ export async function registerClient(authorizationServerUrl, { metadata, clientM
     const response = await (fetchFn ?? fetch)(registrationUrl, {
         method: 'POST',
         headers: {
-            'Content-Type': 'application/json'
