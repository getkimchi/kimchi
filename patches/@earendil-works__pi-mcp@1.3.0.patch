# Patch: OAuth Accept headers for spec-strict gateways (@earendil-works/pi-mcp 1.3.0)
#
# Tracking:
#   - Spec-strict MCP gateways (e.g. agentgateway v1.5.0) answer 406 when the
#     Accept header lacks text/event-stream; remove when upstream sends
#     "Accept: application/json, text/event-stream" on metadata discovery and
#     token/registration calls. Same fix pi previously carried via the
#     @modelcontextprotocol/client@2.3.1 patch for the adapter stack — the
#     client code moved with pi 1.3 to this package.
# Changes:
#   - dist/oauth/discovery.js fetchMetadata: Accept "application/json, text/event-stream".
#   - dist/oauth/flow.js token + registration request headers: same widen.
# Removal: delete when the pinned version sends the widened Accept header natively.
diff --git a/dist/oauth/discovery.js b/dist/oauth/discovery.js
index e1ed433513b766953d311356b8cd68d5f24db661..a1a957e2e7ef2903823b3439744401b391509a37 100644
--- a/dist/oauth/discovery.js
+++ b/dist/oauth/discovery.js
@@ -45,7 +45,7 @@ export function parseWwwAuthenticate(header) {
 }
 async function fetchMetadata(url, fetch, protocolVersion, signal) {
     return fetch(url, {
-        headers: { Accept: "application/json", "MCP-Protocol-Version": protocolVersion },
+        headers: { Accept: "application/json, text/event-stream", "MCP-Protocol-Version": protocolVersion }, // kimchi: spec-strict gateways 406 without text/event-stream
         signal,
     });
 }
diff --git a/dist/oauth/flow.js b/dist/oauth/flow.js
index 6384b460f05bc04c20c1559856ddb28c29f4fdff..39851034a4333bb9e286bcb25ea64b80645ed458 100644
--- a/dist/oauth/flow.js
+++ b/dist/oauth/flow.js
@@ -91,7 +91,7 @@ export async function startAuthorization(authorizationServerUrl, options) {
 }
 async function tokenRequest(authorizationServerUrl, options, params) {
     const url = secureEndpoint(options.metadata?.token_endpoint ?? new URL("/token", authorizationServerUrl));
-    const headers = new Headers({ Accept: "application/json", "content-type": "application/x-www-form-urlencoded" });
+    const headers = new Headers({ Accept: "application/json, text/event-stream", "content-type": "application/x-www-form-urlencoded" }); // kimchi
     if (options.resource)
         params.set("resource", options.resource);
     if (options.addClientAuthentication) {
@@ -126,7 +126,7 @@ export async function registerClient(authorizationServerUrl, options) {
         throw new Error("Authorization server does not support dynamic client registration");
     const response = await (options.fetch ?? globalThis.fetch)(new URL(endpoint ?? new URL("/register", authorizationServerUrl)), {
         method: "POST",
-        headers: { Accept: "application/json", "content-type": "application/json" },
+        headers: { Accept: "application/json, text/event-stream", "content-type": "application/json" }, // kimchi
         body: JSON.stringify({
             ...options.clientMetadata,
             application_type: options.clientMetadata.application_type ?? applicationType(options.clientMetadata.redirect_uris),
