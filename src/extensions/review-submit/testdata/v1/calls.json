          "writer": "final",
          "arguments": {"body": "Valid body.", "score": 82, "estimated_effort_to_review": 3, "environment_gaps": [{"kind": "missing_tool", "name": "tool", "note": "Valid note."}]},
          "generate_string_bytes": {"environment_gaps[0].note": 2049},
          "expect": {"accepted": false, "reason": "invalid_field", "field": "environment_gaps[0].note", "limit": 2048, "message_contains": ["environment_gaps[0].note", "2048"]}
