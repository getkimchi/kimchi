          "arguments": {"body": "Valid body.", "score": 82, "estimated_effort_to_review": 0, "environment_gaps": []},
          "expect": {"accepted": false, "reason": "invalid_field", "field": "estimated_effort_to_review", "message_contains": ["estimated_effort_to_review"]}
        },
        {
          "tool": "submit_summary",
          "writer": "final",
          "arguments": {"body": "Valid body.", "score": 82, "estimated_effort_to_review": 6, "environment_gaps": []},
          "expect": {"accepted": false, "reason": "invalid_field", "field": "estimated_effort_to_review", "message_contains": ["estimated_effort_to_review"]}
        },
        {
          "tool": "submit_summary",
          "writer": "final",
          "arguments": {"body": "Valid body.", "score": 82, "estimated_effort_to_review": 3, "environment_gaps": [{"kind": "missing_tool", "name": "tool", "note": "Valid note."}]},
          "generate_array_lengths": {"environment_gaps": 51},
          "expect": {"accepted": false, "reason": "invalid_field", "field": "environment_gaps", "limit": 50, "message_contains": ["environment_gaps", "50"]}
        },
        {
          "tool": "submit_summary",
          "writer": "final",
          "arguments": {"body": "Valid body.", "score": 82, "estimated_effort_to_review": 3, "environment_gaps": [{"kind": "missing_tool", "name": "tool", "note": "Valid note."}]},
          "generate_string_bytes": {"environment_gaps[0].kind": 65},
          "expect": {"accepted": false, "reason": "invalid_field", "field": "environment_gaps[0].kind", "limit": 64, "message_contains": ["environment_gaps[0].kind", "64"]}
        },
        {
          "tool": "submit_summary",
          "writer": "final",
          "arguments": {"body": "Valid body.", "score": 82, "estimated_effort_to_review": 3, "environment_gaps": [{"kind": "missing_tool", "name": "tool", "note": "Valid note."}]},
          "generate_string_bytes": {"environment_gaps[0].name": 513},
          "expect": {"accepted": false, "reason": "invalid_field", "field": "environment_gaps[0].name", "limit": 512, "message_contains": ["environment_gaps[0].name", "512"]}
        },
